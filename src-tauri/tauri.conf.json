{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runout",
  "version": "0.1.0",
  "identifier": "app.runout.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Runout",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "incognito": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeIdentitySSO,msHubs,msProfileTokenBroker --disable-identity-proxy --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings --disable-sync --disable-client-side-phishing-detection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src https://open.spotify.com; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": {
          "English": "windows/English.nsh"
        }
      }
    }
  }
}
